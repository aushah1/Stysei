<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="text">
    <% if (error && error.length) { %>
    <div
      id="flash-error"
      class="fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-red-500 text-white px-5 py-3 rounded-xl shadow-lg">
      <%= error[0] %>
    </div>
    <% } %> <% if (success && success.length) { %>
    <div
      id="flash-success"
      class="fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-green-500 text-white px-5 py-3 rounded-xl shadow-lg">
      <%= success[0] %>
    </div>
    <% } %>
    <main
      class="flex first-bg min-h-screen md:flex-row flex-col justify-center items-center md:gap-24 lg:p-20 gap-8 p-10">
      <form
        class="login py-16 md:w-full md:max-w-[490px] min-h-[496px] sm:w-[80%] w-[98%] rounded-xl div-bg px-6 flex flex-col justify-center items-center gap-4"
        action="/login"
        method="post">
        <h2 class="sm:text-7xl text-5xl font-bold mb-8">LOGIN</h2>

        <input
          class="input px-3 py-2 rounded-xl w-[80%]"
          type="text"
          name="email"
          placeholder="Email" />
        <input
          class="input px-3 py-2 rounded-xl w-[80%]"
          type="password"
          name="password"
          placeholder="Password" />
        <input
          class="mt-8 cursor-pointer px-5 py-2 text-2xl text-dark btn-bg rounded-2xl"
          type="submit"
          value="Submit" />
      </form>
      <form
        class="signup py-16 md:w-full md:max-w-[490px] sm:w-[80%] w-[98%] rounded-xl div-bg px-6 flex flex-col justify-center items-center gap-4"
        action="/create"
        method="post">
        <h2 class="sm:text-7xl text-5xl font-bold mb-8">SIGNUP</h2>
        <input
          class="input px-3 py-2 rounded-xl w-[80%]"
          type="text"
          name="name"
          placeholder="Name" />
        <input
          class="input px-3 py-2 rounded-xl w-[80%]"
          type="text"
          name="email"
          placeholder="Email" />
        <input
          class="input px-3 py-2 rounded-xl w-[80%]"
          type="password"
          name="password"
          placeholder="Password" />
        <input
          id="signupBtn"
          class="mt-8 cursor-pointer px-5 py-2 text-dark text-2xl btn-bg rounded-2xl"
          type="submit"
          value="Submit" />
      </form>
    </main>
    <script>
      const signupForm = document.querySelector(".signup");
      const signupBtn = document.getElementById("signupBtn");

      signupForm.addEventListener("submit", () => {
        signupBtn.disabled = true;
        signupBtn.value = "Signing up...";
        signupBtn.classList.add("opacity-60", "cursor-not-allowed");
      });
      setTimeout(() => {
        document.getElementById("flash-error")?.remove();
        document.getElementById("flash-success")?.remove();
      }, 3000);
    </script>
  </body>
</html>
