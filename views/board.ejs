<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drawing App</title>
    <!-- Font Awesome for icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css" />

    <style>
      .selected_color {
        border: 2px solid var(--nav-div-hover) !important;
        box-shadow: 0 0 0 2px rgba(var(--nav-div-hover-rgb, 74, 152, 247), 0.2);
      }

      .active_tool {
        background-color: var(--nav-div-hover) !important;
        color: var(--text-dark) !important;
        border-color: var(--nav-div-hover) !important;
      }

      .tool:hover {
        background-color: var(--nav-div) !important;
      }

      /* Laser-specific styles */
      .laser-glow {
        box-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 30px #ff0000;
      }

      .laser-active {
        animation: laser-pulse 0.5s infinite alternate;
      }

      @keyframes laser-pulse {
        from {
          box-shadow: 0 0 5px #ff0000, 0 0 10px #ff0000;
        }
        to {
          box-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000, 0 0 30px #ff0000;
        }
      }
    </style>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <div class="w-full first-bg overflow-hidden py-3 text-dark">
      <!-- Title -->
      <div class="text-center mb-2">
        <h1 class="md:text-5xl text-3xl font-bold text-dark">Drawing Canvas</h1>
        <p class="text-xs text-dark mt-0.5">Create and edit your designs</p>
      </div>

      <div class="md:w-[95%] lg:w-[90%] mx-auto w-full p-1">
        <div class="flex items-center justify-center flex-wrap gap-2">
          <!-- File Menu - Ultra Compact -->
          <div class="text-dark min-h-[129px]">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-folder mr-0.5 text-xl"></i>File
                </span>
              </div>
              <div class="home-div p-2">
                <div class="flex gap-2">
                  <div
                    class="cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[40px]"
                    id="save">
                    <i class="fas fa-download mr-0.5 text-light"></i>
                    <small class="text-lg font-medium mt-0.5">Export</small>
                  </div>
                  <div
                    class="cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[40px]"
                    id="clear">
                    <i class="fas fa-trash-alt text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Clear</small>
                  </div>
                  <div
                    class="cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[40px]"
                    id="undo">
                    <i class="fas fa-undo mr-0.5 text-light"></i>
                    <small class="text-lg font-medium mt-0.5">Undo</small>
                  </div>
                  <div
                    class="cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[40px]"
                    id="redo">
                    <i class="fas fa-redo mr-0.5 text-light"></i>
                    <small class="text-lg font-medium mt-0.5">Redo</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Shapes Menu - Ultra Compact -->
          <div class="text-dark">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-shapes mr-0.5 text-xl"></i>Shapes
                </span>
              </div>
              <div class="home-div p-2">
                <div class="flex gap-2">
                  <div
                    class="tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[35px]"
                    id="rectangle">
                    <i class="far fa-square text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Rect</small>
                  </div>
                  <div
                    class="tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[35px]"
                    id="circle">
                    <i class="far fa-circle text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Circle</small>
                  </div>
                  <div
                    class="tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[35px]"
                    id="triangle">
                    <i class="fas fa-play text-xl transform -rotate-90"></i>
                    <small class="text-lg font-medium mt-0.5">Tri</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tools Menu - Ultra Compact -->
          <div class="text-dark min-h-[129px]">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-tools mr-0.5 text-xl"></i>Tools
                </span>
              </div>
              <div class="home-div p-2 space-y-1">
                <!-- Tools Row -->
                <div class="flex gap-2">
                  <div
                    class="tool active_tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border transition-colors duration-200 min-w-[35px]"
                    id="brush">
                    <i class="fas fa-pen text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Brush</small>
                  </div>
                  <div
                    class="tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[35px]"
                    id="eraser">
                    <i class="fas fa-eraser text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Eraser</small>
                  </div>
                  <!-- Laser Pointer Tool -->
                  <div
                    class="tool cursor-pointer flex flex-col items-center justify-center px-4 py-2 rounded border border-gray-200 transition-colors duration-200 hover:nav-div hover-nav-div min-w-[35px]"
                    id="laser">
                    <i class="fas fa-bolt text-xl"></i>
                    <small class="text-lg font-medium mt-0.5">Laser</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Settings Menu - Ultra Compact (for Fill toggle and Brush Size) -->
          <div class="text-dark min-h-[129px]">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-sliders-h mr-0.5 text-xl"></i>Settings
                </span>
              </div>
              <div class="home-div p-2 space-y-1">
                <!-- Fill Color Toggle -->
                <div class="flex items-center justify-center gap-2">
                  <div class="relative inline-block w-16 h-8 scale-75">
                    <input
                      type="checkbox"
                      name=""
                      id="colorCheck"
                      class="opacity-0 w-0 h-0 peer"
                      onchange="toggleSwitch(this)" />
                    <label
                      for="colorCheck"
                      class="absolute cursor-pointer top-0 left-0 right-0 bottom-0 nav-div rounded-full transition duration-300 before:absolute before:content-[''] before:h-6 before:w-6 before:left-0.5 before:bottom-0.5 before:bg-white before:rounded-full before:transition before:duration-300 peer-checked:btn-bg peer-checked:before:translate-x-9">
                    </label>
                  </div>
                  <div class="flex items-center space-x-0.5">
                    <i class="fas fa-fill-drip text-xl"></i>
                    <span class="text-xl font-medium">Fill</span>
                  </div>
                </div>

                <!-- Brush Size Slider -->
                <div class="space-y-0.5 flex items-center justify-center">
                  <label
                    class="block text-xl font-medium flex items-center justify-center"
                    >Size:
                    <span id="brushSizeValue" class="font-bold"> 5</span
                    >px</label
                  >
                  <input
                    type="range"
                    name=""
                    min="1"
                    max="30"
                    id="slider"
                    value="5"
                    class="w-full custom-slider rounded-lg appearance-none cursor-pointer [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full home-div" />
                </div>
              </div>
            </div>
          </div>

          <!-- Colors Menu - Ultra Compact -->
          <div class="text-dark min-h-[129px]">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-palette mr-0.5 text-xl"></i>Colors
                </span>
              </div>
              <div class="home-div p-2 space-y-1">
                <!-- Color Palette -->
                <div>
                  <label class="block text-xl font-medium mb-0.5">Color</label>
                  <div class="flex items-center gap-1">
                    <!-- Color 1: Red -->
                    <div
                      class="option cursor-pointer group"
                      data-color="#EF4444">
                      <div
                        class="w-6 h-6 rounded-full bg-red-500 border border-gray-300 group-hover:border-red-400 transition-colors duration-200 flex items-center justify-center"></div>
                    </div>

                    <!-- Color 2: Blue -->
                    <div
                      class="option cursor-pointer group"
                      data-color="#3B82F6">
                      <div
                        class="w-6 h-6 rounded-full bg-blue-500 border border-gray-300 group-hover:border-blue-400 transition-colors duration-200 flex items-center justify-center"></div>
                    </div>

                    <!-- Color 3: Green -->
                    <div
                      class="option cursor-pointer group"
                      data-color="#22C55E">
                      <div
                        class="w-6 h-6 rounded-full bg-green-500 border border-gray-300 group-hover:border-green-400 transition-colors duration-200 flex items-center justify-center"></div>
                    </div>

                    <!-- Color Picker -->
                    <div
                      class="option selected_color cursor-pointer group"
                      id="colorPickerOption">
                      <div
                        class="w-6 h-6 rounded-full border border-gray-300 group-hover:border-purple-400 transition-colors duration-200 flex items-center justify-center relative nav-div">
                        <input
                          type="color"
                          name=""
                          id="color_picker"
                          value="#4A98F7"
                          class="opacity-0 absolute w-full h-full cursor-pointer" />
                        <i class="fas fa-eye-dropper text-lg"></i>
                      </div>
                    </div>
                    <!-- Current Color Display -->
                    <div class="p-1 rounded border border-gray-200 home-div">
                      <div class="flex items-center">
                        <div
                          id="currentColorDisplay"
                          class="w-6 h-6 rounded-full border border-gray-300 shadow-xs"
                          style="background-color: #4a98f7"></div>
                        <div></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Background Menu - Ultra Compact -->
          <div class="text-dark min-h-[129px]">
            <div
              class="rounded border border-gray-200 shadow-xs min-h-[129px] overflow-hidden home-div">
              <div
                class="flex items-center justify-between px-1.5 py-1 nav-div">
                <span class="font-medium flex items-center text-[11px]">
                  <i class="fas fa-image mr-0.5 text-xl"></i>Background
                </span>
              </div>
              <div class="home-div p-2 space-y-1">
                <!-- Background Color Options -->
                <div>
                  <label class="block text-xl font-medium mb-0.5"
                    >Board Color</label
                  >
                  <div class="flex items-center gap-1">
                    <!-- White Background -->
                    <div
                      class="bg-option selected_bg_color cursor-pointer group"
                      data-color="#FFFFFF">
                      <div
                        class="w-6 h-6 rounded-full bg-white border border-gray-300 group-hover:border-gray-400 transition-colors duration-200 flex items-center justify-center">
                        <i class="fas fa-border-all text-xs text-gray-600"></i>
                      </div>
                    </div>

                    <!-- Black Background -->
                    <div
                      class="bg-option cursor-pointer group"
                      data-color="#000000">
                      <div
                        class="w-6 h-6 rounded-full bg-black border border-gray-300 group-hover:border-gray-400 transition-colors duration-200 flex items-center justify-center"></div>
                    </div>

                    <!-- Background Color Picker -->
                    <div
                      class="bg-option cursor-pointer group"
                      id="bgColorPickerOption">
                      <div
                        class="w-6 h-6 rounded-full border border-gray-300 group-hover:border-purple-400 transition-colors duration-200 flex items-center justify-center relative nav-div">
                        <input
                          type="color"
                          name=""
                          id="bg_color_picker"
                          value="#FFFFFF"
                          class="opacity-0 absolute w-full h-full cursor-pointer" />
                        <i class="fas fa-fill text-lg"></i>
                      </div>
                    </div>

                    <!-- Current Background Color Display -->
                    <div class="p-1 rounded border border-gray-200 home-div">
                      <div class="flex items-center">
                        <div
                          id="currentBgColorDisplay"
                          class="w-6 h-6 rounded-full border border-gray-300 shadow-xs"
                          style="background-color: #ffffff"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Canvas Area -->
      <div
        class="mt-2 md:w-[95%] lg:w-[90%] mx-auto w-full h-[800px] p-1 relative">
        <!-- Background Canvas -->
        <canvas
          class="w-full h-full rounded shadow-xs absolute top-0 left-0"
          id="backgroundCanvas"></canvas>
        <!-- Main Drawing Canvas -->
        <canvas
          class="w-full h-full rounded absolute top-0 left-0"
          id="mainCanvas"></canvas>
        <!-- Laser Canvas (temporary overlay) -->
        <canvas
          class="w-full h-full rounded absolute top-0 left-0 pointer-events-none"
          id="laserCanvas"></canvas>
      </div>
    </div>
    <%- include("partials/footer") %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Canvas elements
        let backgroundCanvas = document.getElementById("backgroundCanvas");
        let canvas = document.getElementById("mainCanvas");
        let laserCanvas = document.getElementById("laserCanvas");

        // Contexts
        let bgCtx = backgroundCanvas.getContext("2d");
        let ctx = canvas.getContext("2d");
        let laserCtx = laserCanvas.getContext("2d");

        // Drawing variables
        let pageX, pageY;
        let brush_Width = 5;
        let select_tool = "brush";
        let selected_Color = "#4A98F7";
        let canvasBackgroundColor = "#FFFFFF"; // Default background color
        let isDrawing = false;
        let snapshot;
        let isFillEnabled = false;

        // Laser variables
        let laserFadeTimer = null;
        let laserPoints = [];
        let isLaserActive = false;

        // Undo/Redo stacks - now storing canvas drawings only (not background)
        let undoStack = [];
        let redoStack = [];
        let maxStackSize = 50;

        // Initialize canvases
        const initCanvases = () => {
          // Set all canvases to same size
          const width = canvas.offsetWidth;
          const height = canvas.offsetHeight;

          backgroundCanvas.width = width;
          backgroundCanvas.height = height;
          canvas.width = width;
          canvas.height = height;
          laserCanvas.width = width;
          laserCanvas.height = height;

          // Set background canvas
          bgCtx.fillStyle = canvasBackgroundColor;
          bgCtx.fillRect(0, 0, width, height);

          // Clear drawing canvas (transparent)
          ctx.clearRect(0, 0, width, height);
          ctx.fillStyle = selected_Color;

          // Setup laser canvas
          laserCtx.lineCap = "round";
          laserCtx.lineJoin = "round";

          // Set drawing canvas background to transparent
          canvas.style.backgroundColor = "transparent";
        };

        // Function to change canvas background color
        const changeCanvasBackground = (color) => {
          // Save current state before changing background
          saveState();

          // Update background color
          canvasBackgroundColor = color;

          // Update background canvas
          bgCtx.fillStyle = canvasBackgroundColor;
          bgCtx.fillRect(0, 0, backgroundCanvas.width, backgroundCanvas.height);

          // Update display
          document.getElementById(
            "currentBgColorDisplay"
          ).style.backgroundColor = color;

          // Save state after change
          saveState();

          showNotification(`Canvas background changed to ${color}`, "success");
        };

        window.addEventListener("load", () => {
          initCanvases();
          saveState();
        });

        // Save current canvas state to undo stack
        function saveState() {
          if (undoStack.length >= maxStackSize) {
            undoStack.shift();
          }

          // Save only the drawing canvas state (not background)
          undoStack.push(canvas.toDataURL());

          // Clear redo stack when new action is performed
          redoStack = [];

          // Update undo/redo button states
          updateUndoRedoButtons();
        }

        // Restore state from data URL
        function restoreState(dataUrl) {
          const img = new Image();
          img.onload = function () {
            // Clear drawing canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            // Draw the saved state
            ctx.drawImage(img, 0, 0);
          };
          img.src = dataUrl;
        }

        // Update undo/redo button enabled states
        function updateUndoRedoButtons() {
          const undoBtn = document.getElementById("undo");
          const redoBtn = document.getElementById("redo");

          if (undoStack.length > 1) {
            undoBtn.style.opacity = "1";
            undoBtn.style.cursor = "pointer";
          } else {
            undoBtn.style.opacity = "0.5";
            undoBtn.style.cursor = "not-allowed";
          }

          if (redoStack.length > 0) {
            redoBtn.style.opacity = "1";
            redoBtn.style.cursor = "pointer";
          } else {
            redoBtn.style.opacity = "0.5";
            redoBtn.style.cursor = "not-allowed";
          }
        }

        // Undo function
        function undo() {
          if (undoStack.length > 1) {
            // Save current state to redo stack
            redoStack.push(canvas.toDataURL());

            // Remove current state from undo stack
            undoStack.pop();

            // Restore previous state
            const previousState = undoStack[undoStack.length - 1];
            restoreState(previousState);

            showNotification("Undo successful", "success");
            updateUndoRedoButtons();
          } else {
            showNotification("Nothing to undo", "info");
          }
        }

        // Redo function
        function redo() {
          if (redoStack.length > 0) {
            // Save current state to undo stack
            undoStack.push(canvas.toDataURL());

            // Restore next state from redo stack
            const nextState = redoStack.pop();
            restoreState(nextState);

            showNotification("Redo successful", "success");
            updateUndoRedoButtons();
          } else {
            showNotification("Nothing to redo", "info");
          }
        }

        // Update brush size display
        const slider = document.getElementById("slider");
        const brushSizeValue = document.getElementById("brushSizeValue");

        slider.addEventListener("input", function () {
          brushSizeValue.textContent = this.value;
          brush_Width = parseInt(this.value);
        });

        // Tool selection
        const tools = document.querySelectorAll(".tool");

        tools.forEach((tool) => {
          tool.addEventListener("click", function () {
            tools.forEach((t) => t.classList.remove("active_tool"));
            this.classList.add("active_tool");
            select_tool = this.id;

            if (select_tool === "laser") {
              isLaserActive = true;
              document.body.style.cursor = "crosshair";
              showNotification(
                "Laser pointer active - drawings will fade",
                "info"
              );
            } else {
              isLaserActive = false;
              document.body.style.cursor = "default";
            }
          });
        });

        // Drawing Color selection
        const colorOptions = document.querySelectorAll(".option");
        const currentColorDisplay = document.getElementById(
          "currentColorDisplay"
        );
        const colorPickerOption = document.getElementById("colorPickerOption");

        colorOptions.forEach((option) => {
          option.addEventListener("click", function () {
            colorOptions.forEach((opt) =>
              opt.classList.remove("selected_color")
            );
            this.classList.add("selected_color");

            let color;
            if (this.querySelector('input[type="color"]')) {
              color = this.querySelector('input[type="color"]').value;
            } else {
              color = this.getAttribute("data-color");
            }

            updateCurrentColor(color);
            selected_Color = color;
          });
        });

        // Background Color selection
        const bgColorOptions = document.querySelectorAll(".bg-option");
        const currentBgColorDisplay = document.getElementById(
          "currentBgColorDisplay"
        );

        bgColorOptions.forEach((option) => {
          option.addEventListener("click", function () {
            bgColorOptions.forEach((opt) =>
              opt.classList.remove("selected_bg_color")
            );
            this.classList.add("selected_bg_color");

            let color;
            if (this.querySelector('input[type="color"]')) {
              color = this.querySelector('input[type="color"]').value;
            } else {
              color = this.getAttribute("data-color");
            }

            changeCanvasBackground(color);
          });
        });

        // Function to update current color display
        function updateCurrentColor(color) {
          currentColorDisplay.style.backgroundColor = color;

          if (!["#EF4444", "#3B82F6", "#22C55E"].includes(color)) {
            document.getElementById("color_picker").value = color;
          }
        }

        // Color picker input change
        document
          .getElementById("color_picker")
          .addEventListener("input", function () {
            const color = this.value;
            updateCurrentColor(color);
            selected_Color = color;
            colorOptions.forEach((opt) =>
              opt.classList.remove("selected_color")
            );
            colorPickerOption.classList.add("selected_color");
          });

        // Background color picker input change
        document
          .getElementById("bg_color_picker")
          .addEventListener("input", function () {
            const color = this.value;
            bgColorOptions.forEach((opt) =>
              opt.classList.remove("selected_bg_color")
            );
            document
              .getElementById("bgColorPickerOption")
              .classList.add("selected_bg_color");
            changeCanvasBackground(color);
          });

        // Initialize with default color selected
        colorPickerOption.classList.add("selected_color");
        document
          .querySelector('.bg-option[data-color="#FFFFFF"]')
          .classList.add("selected_bg_color");
        updateCurrentColor("#4A98F7");

        // File menu actions
        document.getElementById("save").addEventListener("click", function () {
          // Create a temporary canvas to combine background and drawings
          const tempCanvas = document.createElement("canvas");
          tempCanvas.width = canvas.width;
          tempCanvas.height = canvas.height;
          const tempCtx = tempCanvas.getContext("2d");

          // Draw background first
          tempCtx.fillStyle = canvasBackgroundColor;
          tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

          // Draw the drawings on top
          tempCtx.drawImage(canvas, 0, 0);

          // Save the combined image
          let a = document.createElement("a");
          a.download = "drawing_" + Date.now() + ".jpg";
          a.href = tempCanvas.toDataURL();
          a.click();
          showNotification("Drawing saved successfully", "success");
        });

        document.getElementById("clear").addEventListener("click", function () {
          if (confirm("Clear the canvas? This action cannot be undone.")) {
            saveState();
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            laserCtx.clearRect(0, 0, laserCanvas.width, laserCanvas.height);
            showNotification("Canvas cleared", "info");
            saveState();
          }
        });

        // Fill color toggle function
        const colorCheck = document.getElementById("colorCheck");
        colorCheck.addEventListener("change", function () {
          isFillEnabled = this.checked;
        });

        // Shape selection
        const shapes = document.querySelectorAll(
          "#rectangle, #circle, #triangle"
        );
        shapes.forEach((shape) => {
          shape.addEventListener("click", function () {
            tools.forEach((t) => t.classList.remove("active_tool"));
            shapes.forEach((s) => s.classList.remove("active_tool"));
            this.classList.add("active_tool");
            select_tool = this.id;
            isLaserActive = false;
            document.body.style.cursor = "default";
          });
        });

        // Laser drawing functions
        function drawLaserLine(x1, y1, x2, y2) {
          laserCtx.beginPath();
          laserCtx.moveTo(x1, y1);
          laserCtx.lineTo(x2, y2);

          laserCtx.strokeStyle = "rgba(255, 0, 0, 0.7)";
          laserCtx.lineWidth = brush_Width;
          laserCtx.lineCap = "round";
          laserCtx.shadowColor = "#ff0000";
          laserCtx.shadowBlur = 15;
          laserCtx.stroke();
          laserCtx.shadowBlur = 0;

          laserPoints.push({
            x: x2,
            y: y2,
            time: Date.now(),
          });

          if (!laserFadeTimer) {
            startLaserFade();
          }
        }

        function startLaserFade() {
          laserFadeTimer = setInterval(() => {
            const now = Date.now();
            laserPoints = laserPoints.filter(
              (point) => now - point.time < 1000
            );

            if (laserPoints.length === 0) {
              laserCtx.clearRect(0, 0, laserCanvas.width, laserCanvas.height);
              clearInterval(laserFadeTimer);
              laserFadeTimer = null;
            } else {
              laserCtx.clearRect(0, 0, laserCanvas.width, laserCanvas.height);

              for (let i = 1; i < laserPoints.length; i++) {
                const prevPoint = laserPoints[i - 1];
                const currPoint = laserPoints[i];
                const age = now - currPoint.time;
                const alpha = Math.max(0, 0.7 * (1 - age / 1000));

                laserCtx.beginPath();
                laserCtx.moveTo(prevPoint.x, prevPoint.y);
                laserCtx.lineTo(currPoint.x, currPoint.y);
                laserCtx.strokeStyle = `rgba(255, 0, 0, ${alpha})`;
                laserCtx.lineWidth = brush_Width;
                laserCtx.lineCap = "round";
                laserCtx.shadowColor = `rgba(255, 0, 0, ${alpha * 0.5})`;
                laserCtx.shadowBlur = 10;
                laserCtx.stroke();
                laserCtx.shadowBlur = 0;
              }
            }
          }, 50);
        }

        // Drawing functions
        const drawRect = (e) => {
          if (isFillEnabled) {
            ctx.fillRect(
              e.offsetX,
              e.offsetY,
              pageX - e.offsetX,
              pageY - e.offsetY
            );
          } else {
            ctx.strokeRect(
              e.offsetX,
              e.offsetY,
              pageX - e.offsetX,
              pageY - e.offsetY
            );
          }
        };

        const drawCircle = (e) => {
          ctx.beginPath();
          let radius = Math.sqrt(
            Math.pow(pageX - e.offsetX, 2) + Math.pow(pageY - e.offsetY, 2)
          );
          ctx.arc(pageX, pageY, radius, 0, 2 * Math.PI);
          if (isFillEnabled) {
            ctx.fill();
          } else {
            ctx.stroke();
          }
        };

        const drawTriangle = (e) => {
          ctx.beginPath();
          ctx.moveTo(pageX, pageY);
          ctx.lineTo(e.offsetX, e.offsetY);
          ctx.lineTo(pageX * 2 - e.offsetX, e.offsetY);
          ctx.closePath();
          if (isFillEnabled) {
            ctx.fill();
          } else {
            ctx.stroke();
          }
        };

        // Track if we've saved state for current drawing
        let hasSavedStateForCurrentDraw = false;

        const drawStart = (e) => {
          isDrawing = true;
          pageX = e.offsetX;
          pageY = e.offsetY;

          if (select_tool !== "laser" && !hasSavedStateForCurrentDraw) {
            saveState();
            hasSavedStateForCurrentDraw = true;
          }

          snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);

          ctx.lineWidth = brush_Width;
          ctx.strokeStyle = selected_Color;
          ctx.fillStyle = selected_Color;

          if (select_tool === "brush" || select_tool === "eraser") {
            ctx.beginPath();
            ctx.moveTo(e.offsetX, e.offsetY);
          } else if (select_tool === "laser") {
            laserPoints = [{ x: e.offsetX, y: e.offsetY, time: Date.now() }];
          }
        };

        const drawing = (e) => {
          if (!isDrawing) return;

          if (select_tool === "brush") {
            ctx.strokeStyle = selected_Color;
            ctx.lineTo(e.offsetX, e.offsetY);
            ctx.stroke();
          } else if (select_tool === "eraser") {
            // SIMPLE ERASER: Draw with transparent color using destination-out
            ctx.globalCompositeOperation = "destination-out";
            ctx.strokeStyle = "rgba(0,0,0,1)"; // Color doesn't matter, alpha does
            ctx.lineTo(e.offsetX, e.offsetY);
            ctx.stroke();
            ctx.globalCompositeOperation = "source-over";
          } else if (select_tool === "laser") {
            drawLaserLine(pageX, pageY, e.offsetX, e.offsetY);
            pageX = e.offsetX;
            pageY = e.offsetY;
          } else {
            ctx.putImageData(snapshot, 0, 0);
            if (select_tool === "rectangle") {
              drawRect(e);
            } else if (select_tool === "circle") {
              drawCircle(e);
            } else if (select_tool === "triangle") {
              drawTriangle(e);
            }
          }
        };

        // Add canvas event listeners
        canvas.addEventListener("mousedown", drawStart);
        canvas.addEventListener("mousemove", drawing);
        canvas.addEventListener("mouseup", () => {
          if (!isDrawing) return;

          isDrawing = false;
          if (select_tool === "brush" || select_tool === "eraser") {
            ctx.closePath();
            // Reset composite operation
            ctx.globalCompositeOperation = "source-over";
          }

          hasSavedStateForCurrentDraw = false;
        });

        // Resize handler
        window.addEventListener("resize", () => {
          initCanvases();
          if (undoStack.length > 0) {
            restoreState(undoStack[undoStack.length - 1]);
          }
        });

        // Add event listeners for undo/redo buttons
        document.getElementById("undo").addEventListener("click", undo);
        document.getElementById("redo").addEventListener("click", redo);

        // Keyboard shortcuts
        document.addEventListener("keydown", function (e) {
          if ((e.ctrlKey || e.metaKey) && e.key === "z") {
            e.preventDefault();
            if (e.shiftKey) {
              redo();
            } else {
              undo();
            }
          }

          if ((e.ctrlKey || e.metaKey) && e.key === "y") {
            e.preventDefault();
            redo();
          }

          if (e.key === "l" || e.key === "L") {
            e.preventDefault();
            document.getElementById("laser").click();
          }

          if (e.key === "b" || e.key === "B") {
            e.preventDefault();
            document.getElementById("brush").click();
          }

          if (e.key === "e" || e.key === "E") {
            e.preventDefault();
            document.getElementById("eraser").click();
          }

          if (e.key === "g" || e.key === "G") {
            e.preventDefault();
            document.getElementById("bgColorPickerOption").click();
          }
        });

        // Notification function
        function showNotification(message, type) {
          const notification = document.createElement("div");
          notification.className = `fixed top-4 right-4 px-4 py-2 rounded-lg shadow-lg text-white text-sm z-50 ${
            type === "success"
              ? "bg-green-600"
              : type === "error"
              ? "bg-red-600"
              : "bg-blue-600"
          }`;
          notification.textContent = message;

          document.body.appendChild(notification);

          setTimeout(() => {
            notification.remove();
          }, 3000);
        }

        // Hover effects for color options
        const allColorDivs = document.querySelectorAll(
          ".option div, .bg-option div"
        );
        allColorDivs.forEach((div) => {
          div.addEventListener("mouseenter", function () {
            if (
              !this.parentElement.classList.contains("selected_color") &&
              !this.parentElement.classList.contains("selected_bg_color")
            ) {
              this.classList.add("transform", "scale-110");
            }
          });

          div.addEventListener("mouseleave", function () {
            this.classList.remove("transform", "scale-110");
          });
        });

        // Initialize undo/redo button states
        updateUndoRedoButtons();
      });
    </script>
  </body>
</html>
